# Production secrets -> copy to .env.prod (git mein KABHI nahi). Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                       (JWT, DB password)
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"     (encryption key)
#   python -m faceai.security.auth                                                    (API key + hash)
FACEAI_DOMAIN=attendance.example.com
POSTGRES_PASSWORD=
FACEAI_JWT_SECRET=
FACEAI_ENCRYPTION_KEYS=
FACEAI_API_KEY_HASHES=
# Calibrate on your cameras first: python -m faceai.eval.calibrate
FACEAI_MATCH_THRESHOLD=0.4
FACEAI_TIMEZONE=Asia/Kolkata
FACEAI_RETENTION_DAYS=365
