# Caddy: automatic HTTPS (Let's Encrypt) + static frontend + API reverse proxy.
# FACEAI_DOMAIN=attendance.example.com  -> real certificate (DNS A record server pe point kare)
# FACEAI_DOMAIN=localhost               -> Caddy ka local CA (dev/staging, browser warning)
# Camera (getUserMedia) sirf HTTPS ya localhost pe chalta hai -> phone ke liye HTTPS zaroori.
{$FACEAI_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'"
		-Server
	}

	# API: /metrics public internet pe NAHI (sirf Prometheus, internal network se)
	@metrics path /metrics
	respond @metrics 404

	handle /v1/* {
		reverse_proxy api:8000
	}
	handle /health/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# hashed assets: 1 saal cache; index.html/sw.js: hamesha fresh (naya deploy turant dikhe)
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fresh path /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 12MB
	}
}
