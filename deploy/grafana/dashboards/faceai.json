{
  "title": "FaceAI",
  "uid": "faceai",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Ready",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "faceai_ready"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Persons",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "faceai_persons"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Indexed embeddings",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "faceai_index_embeddings"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Req/s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(faceai_http_requests_total[5m]))"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "5xx ratio",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(faceai_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(faceai_http_requests_total[5m])),1e-9)"
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Avg embed batch",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "faceai_embed_batch_avg_size"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Requests by route/status",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,status) (rate(faceai_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "/v1/recognize latency",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(faceai_http_request_duration_seconds_bucket{route=\"/v1/recognize\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(faceai_http_request_duration_seconds_bucket{route=\"/v1/recognize\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(faceai_http_request_duration_seconds_bucket{route=\"/v1/recognize\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Model time p95 by stage",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,stage) (rate(faceai_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Capacity: in-flight & 503 rejections",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "faceai_inference_in_flight",
          "legendFormat": "in flight"
        },
        {
          "refId": "B",
          "expr": "rate(faceai_overload_rejections_total[5m])",
          "legendFormat": "rejections/s"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Unknown rate",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(faceai_recognitions_total{result=\"unknown\"}[15m])) / clamp_min(sum(rate(faceai_recognitions_total[15m])),1e-9)",
          "legendFormat": "unknown"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Top-1 similarity (median, p10)",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(faceai_top1_similarity_bucket[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.1, sum by (le) (rate(faceai_top1_similarity_bucket[15m])))",
          "legendFormat": "p10"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Drift PSI by feature",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "faceai_drift_psi",
          "legendFormat": "{{feature}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Faces per image (avg)",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(faceai_faces_per_image_sum[15m]) / clamp_min(rate(faceai_faces_per_image_count[15m]),1e-9)",
          "legendFormat": "faces/image"
        }
      ],
      "id": 14
    }
  ]
}
