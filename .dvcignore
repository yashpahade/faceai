# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Registry metadata (Phase 3): weights nahi hai, embed stage ko invalidate nahi karna chahiye
models/*/model_card.json

# Python bytecode: har checkout/import pe badalta hai, code ka hissa nahi. Iske bina
# src/ directory deps ka hash machine-to-machine alag aata hai (CI pe eval hamesha "stale").
__pycache__/
*.pyc
