# Copy to .env and edit. .env git mein commit NAHI hoti.
FACEAI_ENV=dev
FACEAI_PORT=8000
FACEAI_LOG_LEVEL=INFO
FACEAI_LOG_JSON=false

FACEAI_DET_THRESHOLD=0.5
FACEAI_MATCH_THRESHOLD=0.4
FACEAI_MAX_UPLOAD_MB=10

# Serving performance (Phase 4) - docs/phase-4-serving.md
FACEAI_BATCHING=off
FACEAI_BATCH_MAX_SIZE=16
FACEAI_BATCH_MAX_WAIT_MS=3
FACEAI_MAX_CONCURRENT_INFERENCE=4
FACEAI_MAX_QUEUE_WAIT_MS=2000

# Trust & safety (Phase 7) - docs/phase-7-trust-safety.md
# FACEAI_ENV=prod mein dono ZAROORI hain, warna app ready nahi hogi (fail closed).
# Key:   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# FACEAI_ENCRYPTION_KEYS=
# API key + hash:  python -m faceai.security.auth
# FACEAI_API_KEY_HASHES=
FACEAI_AUTH=auto
FACEAI_LIVENESS=off
# FACEAI_RETENTION_DAYS=365
